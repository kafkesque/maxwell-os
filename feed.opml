    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- MLX INFERENCE ENGINES — evaluated 2026-07-27                  -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <outline text="MLX Inference Engines" description="Apple Silicon LLM servers — alternatives to OMLX">

      <!-- Rapid-MLX / vLLM-MLX — HIGHEST POTENTIAL but cache issue -->
      <outline type="link" text="⭐ Rapid-MLX (vLLM-MLX) — 2-4x faster than Ollama" 
               url="https://github.com/raullenchai/Rapid-MLX"
               description="⭐3,423 | Python | Apache-2.0 | Pure MLX kernels. Continuous batching, prompt cache (radix+DeltaNet RNN), KV cache quantization (int4/int8), 0.08s cached TTFT. Drop-in OpenAI/Anthropic API on port 8000. 165+ text model aliases. ISSUE: v0.11.0 pulls models from HF network instead of using ~/.cache/huggingface/ — violates C1/C3. Monitor for cache-respecting release."/>

      <!-- MTPLX — Native MTP speculative decoding -->
      <outline type="link" text="⭐ MTPLX — Native MTP speculative decoding" 
               url="https://github.com/youssofal/MTPLX"
               description="⭐1,102 | Python | Apache-2.0 | Uses model's built-in MTP heads (no external drafter). Claims 1.6-2.24x decode on M4/M5. ISSUE: M5 TensorOps required for hardware acceleration. M1 Max flagged as 'hardware acceleration confirmed: false'. Benefit at temp=0.0 likely minimal. Monitor for M1-optimized release."/>

      <!-- CIDER — INT8 TensorOps -->
      <outline type="link" text="CIDER — W8A8/W4A8 INT8 TensorOps" 
               url="https://github.com/Mininglamp-AI/cider"
               description="⭐332 | Python | MIT | Unlocks unused INT8 TensorOps on Apple Silicon. SDPA decode kernel 1.2-1.9x. ISSUE: INT8 TensorOps only compile on M5+. M1 Max gets SDPA decode kernel only (~1.0-1.1x). Revisit on M5+ hardware."/>

      <!-- OMLX — Current baseline -->
      <outline type="link" text="✅ OMLX — Current Maxwell baseline" 
               url="https://github.com/nlpxio/omlx"
               description="⭐18,215 | Python | Apache-2.0 | LLM inference server with continuous batching & SSD caching. Already deployed on port 11435. 30 tok/s on Qwen3.6-35B-A3B. Works with HF cache. PROVEN, STABLE."/>

      <!-- mlx-serve — No-Python server -->
      <outline type="link" text="mlx-serve — No-Python MLX server" 
               url="https://github.com/ddalcu/mlx-serve"
               description="⭐374 | Swift | No Python runtime. Smaller footprint. Same MLX backend — no performance advantage over OMLX. Monitor for maturity."/>
    </outline>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- MODEL EVALUATION TOOLS — evaluated 2026-07-27                 -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <outline text="Model Evaluation Tools" description="Hardware fit and model selection">

      <!-- llmfit — ADOPTED -->
      <outline type="link" text="✅ llmfit — Hardware-model fit checker (ADOPTED)" 
               url="https://github.com/AlexsJones/llmfit"
               description="⭐30,752 | Rust/Python | MIT | Detects hardware, scores models across fit/speed/quality/context. v1.1.6 installed via pip. Integration script at scripts/llmfit_check.sh. USE FOR ALL NEW MODEL EVALUATION."/>

      <!-- whichllm — Alternative -->
      <outline type="link" text="whichllm — Community benchmark rankings" 
               url="https://github.com/maziyarpanahi/whichllm"
               description="⭐6,019 | Real community-tested tok/s rankings. Different approach: measures, doesn't estimate. Good cross-reference for llmfit estimates."/>
    </outline>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- FAISS ALTERNATIVES & ACCELERATORS                             -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <outline text="FAISS Alternatives &amp; Accelerators" description="Evaluated via GitHub topic search 2026-07-16">
      
      <!-- USearch — HIGHEST POTENTIAL -->
      <outline type="link" text="⭐ USearch — FAISS Replacement (search + clustering)" 
               url="https://github.com/unum-cloud/USearch"
               description="⭐4,216 | C++/Python | Apache-2.0 | SIMD-optimized (NEON for Apple Silicon). 10x faster HNSW than FAISS. Has clustering (KNN), PCA, multi-language bindings. Single-header C++11. Used by Google, ClickHouse, DuckDB. Updated daily. TOP CANDIDATE for S1.5 replacement."/>

      <!-- Turbovec — ALREADY INSTALLED -->
      <outline type="link" text="⭐ TurboVec — Quantized search accelerator" 
               url="https://github.com/RyanCodrai/turbovec"
               description="⭐12,846 | Python/Rust | MIT | 2-4 bit quantized vector index. Metal SIMD on Apple Silicon. 4-8x faster search than FAISS brute-force. Already installed (v0.8.0). Use case: S1.5 k-NN search phase, FB retrieval."/>

      <!-- LEANN — FB retrieval layer -->
      <outline type="link" text="⭐ LEANN — 97% storage savings RAG" 
               url="https://github.com/StarTrail-org/LEANN"
               description="⭐12,688 | Python | MIT | MLsys2026 paper. 97% storage savings, fast, accurate, 100% private RAG on personal devices. Uses FAISS internally. Compelling for FB retrieval/reasoning layer."/>

      <!-- zvec — lightweight embedded vector DB -->
      <outline type="link" text="⭐ zvec — Lightweight embedded vector DB" 
               url="https://github.com/alibaba/zvec"
               description="⭐14,942 | C++ | Apache-2.0 | Lightweight, lightning-fast, in-process vector database by Alibaba. HNSW, embedded, no server. Could replace FAISS for persistent vector storage."/>

      <!-- memvid — agent memory -->
      <outline type="link" text="⭐ memvid — Agent memory layer" 
               url="https://github.com/memvid/memvid"
               description="⭐15,901 | Rust | Apache-2.0 | Memory layer for AI agents. Serverless, single-file. Replace complex RAG pipelines. Knowledge graph support. Use case: Maxwell agent memory, not pipeline."/>

      <!-- sqlite-vss — SQLite vectors -->
      <outline type="link" text="⭐ sqlite-vss — SQLite vector extension" 
               url="https://github.com/asg017/sqlite-vss"
               description="⭐1,997 | C++ | MIT | SQLite extension for vector search based on FAISS. Unifies vectors + metadata in SQLite (already used for session_episodes). Use case: persistent vector + metadata store."/>

      <!-- LightRAG — graph-based RAG -->
      <outline type="link" text="⭐ LightRAG — Graph-based RAG" 
               url="https://github.com/HKUDS/LightRAG"
               description="⭐37,713 | Python | EMNLP2025 paper. Simple and fast graph-based RAG. Entity-relation extraction + graph traversal. Use case: FB retrieval quality improvement via graph approach."/>

      <!-- FAISS (baseline) -->
      <outline type="link" text="⭐ FAISS — Current baseline" 
               url="https://github.com/facebookresearch/FAISS"
               description="⭐34,000+ | C++/Python | MIT | Current S1.5 clustering engine. Meta, 7+ years. IndexFlatIP (brute-force) + KMeans. Keep for clustering; consider USearch as faster alternative."/>
    </outline>

