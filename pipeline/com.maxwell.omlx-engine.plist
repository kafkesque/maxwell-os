<?xml version="1.0" encoding="UTF-8"?>
<!-- BUG-802 remedy: the local engine must survive a reboot, and must NOT be started twice.
     D2455/D2456 record that a blind start spawns a DUPLICATE managed server, so the job runs
     pipeline/omlx_engine_guard.sh instead: the guard exits 0 when the engine already answers
     /health and only brings the app up when nothing does.
     BUG-940: the guard is DEPLOYED to @HOME@/.omlx/ (never exec'd from the repo) because launchd
     cannot exec a script under a TCC-protected Dropbox/CloudStorage path (exit 126). Its engine
     facts are rendered into EnvironmentVariables so the job reads nothing from the repo at runtime.
     TEMPLATE: @HOME@, @REPO@, @ENGINE_HOST@, @ENGINE_PORT@ and @ENGINE_BUNDLE@ are substituted by
     pipeline/install_omlx_engine_agent.sh at install time (C12: the repo stores no absolute path;
     C26: the same template fits any account).
     KeepAlive is {SuccessfulExit: false}: restart ONLY on FAILURE. A guard that finds the engine
     healthy exits 0, and a clean exit must not be retried. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.maxwell.omlx-engine</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.omlx/omlx_engine_guard.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OMLX_ENGINE_HOST</key><string>@ENGINE_HOST@</string>
    <key>OMLX_ENGINE_PORT</key><string>@ENGINE_PORT@</string>
    <key>OMLX_ENGINE_BUNDLE</key><string>@ENGINE_BUNDLE@</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>@HOME@/.omlx/logs/boot_agent.out.log</string>
  <key>StandardErrorPath</key><string>@HOME@/.omlx/logs/boot_agent.err.log</string>
</dict>
</plist>
