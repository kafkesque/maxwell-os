# Maxwell OS v3.0 — Environment
# Copy to .env and fill in values
# D2184: Removed developer-specific absolute paths (cross-platform portability, C26)

# Paths
# MAXWELL_PIPELINE_ROOT=/path/to/maxwell-os  # defaults to repo root

# OMLX (local LLM server)
OMLX_BASE_URL=http://localhost:11435/v1
OMLX_API_KEY=not-needed

# Ollama (embeddings)
OLLAMA_BASE_URL=http://localhost:11434

# Anytype (post-MVP)
# ANYTYPE_API_URL=http://localhost:31006
# ANYTYPE_TOKEN=

# HuggingFace (model downloads)
# HF_TOKEN=
